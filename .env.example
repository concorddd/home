# Copie estas variáveis para o painel da plataforma de deploy (ex.: Vercel).
# Vercel -> Project Settings -> Environment Variables (Production + Preview + Development)
#
# Os valores atuais estão no seu arquivo local .env (que NÃO é versionado).
# IMPORTANTE: o app lança erro se SUPABASE_URL ou SUPABASE_PUBLISHABLE_KEY
# não existirem em runtime. Configure TODAS abaixo e faça deploy novamente.

SUPABASE_PROJECT_ID=seu_project_id
SUPABASE_PUBLISHABLE_KEY=sua_publishable_key
SUPABASE_URL=https://seu-proxy-ou-projeto.supabase.co

VITE_SUPABASE_PROJECT_ID=seu_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=sua_publishable_key
VITE_SUPABASE_URL=https://seu-proxy-ou-projeto.supabase.co